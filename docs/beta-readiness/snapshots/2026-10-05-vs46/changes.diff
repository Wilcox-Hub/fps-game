+#include "RidgefireHUD.h"
+#include "RidgefireWeaponProgression.h"
+#include "Variant_Shooter/ShooterPlayerController.h"
+#include "Engine/Canvas.h"
+#include "Engine/Engine.h"
+
+bool ARidgefireHUD::DrawSetupScreen()
+{
+    auto* PC = Cast<AShooterPlayerController>(PlayerOwner);
+    UFont* Font = GEngine ? GEngine->GetMediumFont() : nullptr;
+    if (!PC || !Canvas || !Font || PlayerOwner->IsPaused()) return false;
+    const auto& S = PC->GetRidgefireRunState();
+    const bool bPerks = PC->IsPersonalPerksOpen() || (S.bArmoryOpen && S.SetupStage == ERidgefireSetupStage::PersonalPerks);
+    const bool bWeapons = S.bArmoryOpen && (S.SetupStage == ERidgefireSetupStage::Secondary || S.SetupStage == ERidgefireSetupStage::Weapons);
+    const float W = Canvas->ClipX, H = Canvas->ClipY;
+    // Preserve the compact/portrait layout outside this landscape presentation.
+    if ((!bPerks && !bWeapons) || W < 900 || H < 500) return false;
+    const FLinearColor Paper(.98f,.94f,.85f), Ice(.48f,.92f,.84f), Ember(1,.55f,.28f);
+    const FLinearColor Muted(.68f,.73f,.77f), Panel(.045f,.065f,.08f,1);
+    DrawRect(FLinearColor(.012f,.019f,.028f,1),0,0,W,H);
+    auto Line = [&](FString Value,float X,float Y,float Width,float Size,FLinearColor Color) {
+        const float Scale=Size*H/720.f;
+        float TW,TH;
+        Canvas->StrLen(Font,Value,TW,TH);
+        if (TW*Scale>W*Width) {
+            while(Value.Len()>1) {
+                Value.LeftChopInline(1);
+                Canvas->StrLen(Font,Value+TEXT("..."),TW,TH);
+                if(TW*Scale<=W*Width) break;
+            }
+            Value+=TEXT("...");
+        }
+        DrawText(Value,Color,W*X,H*Y,Font,Scale);
+    };
+    auto Wrapped = [&](const FString& Value,float X,float Y,float Width,float Size,int32 MaxLines,FLinearColor Color) {
+        TArray<FString> Words; Value.ParseIntoArray(Words,TEXT(" "),true);
+        FString Row; int32 Index=0;
+        const float Step=Size/720.f*22.f;
+        for(const FString& Word:Words) {
+            const FString Next=Row.IsEmpty()?Word:Row+TEXT(" ")+Word;
+            float TW,TH; Canvas->StrLen(Font,Next,TW,TH);
+            if(!Row.IsEmpty() && TW*Size*H/720.f>W*Width) {
+                if(Index==MaxLines-1) {Line(Row+TEXT("..."),X,Y+Index*Step,Width,Size,Color);return;}
+                Line(Row,X,Y+Index++*Step,Width,Size,Color); Row=Word;
+            } else Row=Next;
+        }
+        if(!Row.IsEmpty()) Line(Row,X,Y+Index*Step,Width,Size,Color);
+    };
+    const bool bGamepad=PC->IsUsingGamepad();
+    if(bPerks) {
+        const auto& Profile=PC->GetPersonalProgression();
+        Line(TEXT("PERSONAL PERKS"),.04f,.045f,.68f,2.4f,Paper);
+        Line(S.bArmoryOpen?FString::Printf(TEXT("LOCKS IN %02d s"),S.SetupSeconds):TEXT("YOUR LOADOUT"),.74f,.055f,.22f,1.5f,Ice);
+        for(int32 Slot=0;Slot<2;++Slot) {
+            const float X=.04f+Slot*.47f;
+            const auto* Perk=RidgefireProgression::GetPerk(Slot==0?Profile.FirstPerk:Profile.SecondPerk);
+            DrawRect(Panel,W*X,H*.125f,W*.45f,H*.1f);
+            Line(FString::Printf(TEXT("SLOT %d"),Slot+1),X+.015f,.137f,.42f,1.0f,Muted);
+            Line(Perk?Perk->Name:TEXT("Empty"),X+.015f,.168f,.42f,1.6f,Ice);
+        }
+        for(int32 Node=0;Node<RidgefireProgression::PerkCount;++Node) {
+            const auto* Perk=RidgefireProgression::GetPerk(Node);
+            const bool bSelected=Node==PC->GetPersonalPerkCursor();
+            const bool bUnlocked=Profile.XP>=Perk->UnlockXP;
+            const float Y=.265f+Node*.053f;
+            if(bSelected) DrawRect(FLinearColor(.1f,.16f,.19f,1),W*.04f,H*(Y-.006f),W*.43f,H*.05f);
+            Line(Perk->Name,.055f,Y,.30f,1.3f,bSelected?Ice:bUnlocked?Paper:Muted);
+            Line(Node==Profile.FirstPerk?TEXT("SLOT 1"):Node==Profile.SecondPerk?TEXT("SLOT 2"):bUnlocked?TEXT("READY"):TEXT("LOCKED"),.37f,Y,.085f,1.0f,bUnlocked?Ice:Muted);
+        }
+        const auto* Selected=RidgefireProgression::GetPerk(PC->GetPersonalPerkCursor());
+        if(Selected) {
+            DrawRect(Panel,W*.50f,H*.26f,W*.46f,H*.53f);
+            Line(Selected->Category,.525f,.286f,.41f,1.15f,Muted);
+            Wrapped(Selected->Name,.525f,.345f,.41f,2.0f,2,Paper);
+            Wrapped(Selected->Description,.525f,.47f,.41f,1.75f,4,Ice);
+            Line(Profile.XP>=Selected->UnlockXP?TEXT("AVAILABLE TO EQUIP"):FString::Printf(TEXT("UNLOCKS AT %d XP  /  YOU HAVE %d"),Selected->UnlockXP,Profile.XP),.525f,.7f,.41f,1.2f,Muted);
+        }
+        Line(bGamepad?TEXT("D-PAD: browse    A: slot 1    X: slot 2"):TEXT("UP / DOWN: browse    1: slot 1    2: slot 2"),.04f,.845f,.92f,1.5f,Ice);
+        Line(S.bArmoryOpen?TEXT("Saved choices stay equipped when the timer ends."):bGamepad?TEXT("L3: return to the game"):TEXT("K: return to the game"),.04f,.905f,.92f,1.15f,Muted);
+        return true;
+    }
+    const bool bSecondary=S.SetupStage==ERidgefireSetupStage::Secondary;
+    const int32 Secondary=S.WeaponOffers.IsValidIndex(S.SecondaryWeaponOfferIndex)?S.SecondaryWeaponOfferIndex:1;
+    Line(bSecondary?TEXT("CHOOSE YOUR SECONDARY"):TEXT("CHOOSE YOUR PRIMARY"),.04f,.045f,.70f,2.4f,Paper);
+    Line(FString::Printf(TEXT("%02d s REMAINING"),bSecondary?S.SetupSeconds:S.ArmorySecondsRemaining),.77f,.055f,.19f,1.4f,Ice);
+    Line(bSecondary?TEXT("You start with two guns: one primary + this secondary."):TEXT("Your secondary is reserved. Choose the primary you will deploy with."),.04f,.12f,.92f,1.5f,Ice);
+    for(int32 Index=0;Index<FMath::Min(3,S.WeaponOffers.Num());++Index) {
+        const auto& Gun=S.WeaponOffers[Index];
+        const bool bReserved=!bSecondary && Index==Secondary;
+        const bool bSelectable=bSecondary || (!bReserved && !Gun.bWildcard);
+        const bool bChosen=bSecondary && Index==Secondary;
+        const float X=.04f+Index*.315f;
+        DrawRect(Panel,W*X,H*.215f,W*.29f,H*.515f);
+        DrawRect(bChosen?Ice:bReserved||!bSelectable?Muted:Ember,W*X,H*.215f,W*.29f,H*.004f);
+        Line(bReserved?TEXT("RESERVED SECONDARY"):!bSelectable?TEXT("FIND DURING THE RUN"):FString::Printf(TEXT("%d  /  %s"),Index+1,bChosen?TEXT("SELECTED"):TEXT("CHOOSE")),X+.015f,.242f,.26f,1.15f,bChosen?Ice:Muted);
+        Wrapped(Gun.Name,X+.015f,.3f,.26f,1.85f,2,Paper);
+        Line(Gun.ModeName,X+.015f,.412f,.26f,1.1f,Muted);
+        const auto Stats=RidgefireWeaponProgression::Stats(Gun);
+        Line(FString::Printf(TEXT("Damage / shot     %.0f"),Stats.Damage),X+.015f,.47f,.26f,1.3f,Paper);
+        Line(FString::Printf(TEXT("Fire rate              %.0f /min"),Stats.RPM),X+.015f,.516f,.26f,1.3f,Paper);
+        Line(FString::Printf(TEXT("Magazine             %d rounds"),Gun.MagazineSize),X+.015f,.562f,.26f,1.3f,Paper);
+        Line(FString::Printf(TEXT("Recoil                  %s"),RidgefireWeaponProgression::RecoilLabel(Stats.RecoilDegrees)),X+.015f,.608f,.26f,1.3f,Paper);
+        Wrapped(Gun.Description,X+.015f,.655f,.26f,1.05f,2,Muted);
+    }
+    const FString SecondaryName=S.WeaponOffers.IsValidIndex(Secondary)?S.WeaponOffers[Secondary].Name:TEXT("Phasma Rifle");
+    Line(TEXT("YOUR STARTING LOADOUT"),.04f,.755f,.92f,1.1f,Muted);
+    Line(bSecondary?TEXT("PRIMARY: choose after the team vote"):TEXT("PRIMARY: choose an available gun above"),.04f,.8f,.44f,1.4f,Paper);
+    Line(TEXT("SECONDARY: ")+SecondaryName,.51f,.8f,.45f,1.4f,Ice);
+    Line(bGamepad?TEXT("A: weapon 1    B: weapon 2    X: weapon 3"):bSecondary?TEXT("1 / 2 / 3: choose secondary    Change until the timer ends"):TEXT("1 / 2: choose an available primary    Deploys when selected"),.04f,.86f,.92f,1.5f,Ice);
+    Line(TEXT("In combat and the arsenal: 1 = primary    2 = secondary    3 = extra weapon"),.04f,.92f,.92f,1.2f,Muted);
+    return true;
+}
