+param(
+    [string]$EngineRoot='G:/Unreal Engine/UE_5.8',
+    [ValidateRange(60,300)][int]$TimeoutSeconds=180,
+    [switch]$Render,
+    [ValidateRange(640,3840)][int]$ResX=1280,
+    [ValidateRange(360,2160)][int]$ResY=720
+)
+Set-StrictMode -Version Latest
+$ErrorActionPreference='Stop'
+$project=(Resolve-Path (Join-Path $PSScriptRoot '../Ridgefire.uproject')).Path
+$log=Join-Path (Split-Path $project) ('Saved/Logs/IRON-SUN-Arsenal-{0}.log' -f (Get-Date -Format 'yyyyMMdd-HHmmss-fff'))
+$arguments=@(('"'+$project+'"'),'/Game/Variant_Shooter/Lvl_Shooter','-game','-NoSound','-unattended','-nop4','-nosplash',
+    '-ExecCmds="t.MaxFPS 60,t.IdleWhenNotForeground 0,Automation RunTests Ridgefire.Weapons.Arsenal.PurchaseConfirmations;"',
+    '-TestExit="Automation Test Queue Empty"',('-abslog="'+$log+'"'))
+if($Render){
+    $arguments+=@('-RenderOffscreen','-windowed','-ForceRes',"-ResX=$ResX","-ResY=$ResY",'-d3d12','-RidgefireArsenalRender')
+    $arguments+='-ini:Engine:[/Script/Engine.AutomationTestSettings]:DefaultInteractiveFramerate=1,[/Script/Engine.AutomationTestSettings]:DefaultInteractiveFramerateDuration=0.1,[/Script/Engine.AutomationTestSettings]:DefaultInteractiveFramerateWaitTime=10'
+}else{$arguments+='-NullRHI'}
+$process=Start-Process -FilePath (Join-Path $EngineRoot 'Engine/Binaries/Win64/UnrealEditor.exe') -ArgumentList $arguments -PassThru -WindowStyle Hidden
+try{
+    $deadline=(Get-Date).AddSeconds($TimeoutSeconds)
+    while(!$process.HasExited -and (Get-Date)-lt $deadline){Start-Sleep -Milliseconds 500}
+    if(!$process.HasExited){throw "Arsenal confirmation timeout: $log"}
+    $content=Get-Content -LiteralPath $log -Raw
+    if($process.ExitCode -ne 0 -or !$content.Contains('Result={Success} Name={PurchaseConfirmations}') -or
+        !$content.Contains('RIDGEFIRE ARSENAL CONFIRMATIONS COMPLETE') -or
+        $content -match 'Result=\{Fail|Fatal error:|Assertion failed:|Ensure condition failed'){
+        throw "Arsenal confirmations failed or did not execute: $log"
+    }
+    if($Render){
+        $captures=[regex]::Matches($content,'(?m)^.*LogTemp: Display: RIDGEFIRE ARSENAL CAPTURE (.+\.png)\s*$')
+        if($captures.Count -ne 8){throw "Expected eight confirmation/comparison frames: $log"}
+        foreach($capture in $captures){
+            $path=$capture.Groups[1].Value.Trim()
+            if(!(Test-Path -LiteralPath $path) -or (Get-Item -LiteralPath $path).Length -le 24){throw "Missing frame: $path"}
+            Write-Output "Capture for inspection: $path"
+        }
